# Multi-Row Subquery

CREATE TABLE students (
    studentname VARCHAR(50),
    subject VARCHAR(50),
    mark INT
);

INSERT INTO students (studentname, subject, mark) VALUES
('Arun', 'Tamil', 85),
('Arun', 'English', 78),
('Arun', 'Maths', 92),
('Arun', 'Science', 88),
('Divya', 'Tamil', 74),
('Divya', 'Social', 90);

SELECT studentname, subject, mark 
FROM students 
WHERE subject IN (
    SELECT DISTINCT subject 
    FROM students 
    WHERE subject IN ('Tamil', 'English', 'Maths')
);

